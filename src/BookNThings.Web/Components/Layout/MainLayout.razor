@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Breakpoint="Breakpoint.Md" Class="spurs-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="app-main">
        <MudContainer MaxWidth="MaxWidth.Large" Class="app-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#007C7C",
            Secondary = "#FF8200",
            Tertiary = "#EF3E72",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#101214",
            DrawerBackground = "#05AFAF",
            DrawerText = "#FFFFFF",
            DrawerIcon = "#FFFFFF",
            Background = "#EFEEE7",
            Surface = "#FBFAF7",
            TextPrimary = "#101214",
            TextSecondary = "#5D6368",
            LinesDefault = "#DDD9CF",
            Divider = "#DDD9CF",
            Success = "#2E7D32",
            Error = "#B00020"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "18px",
            DrawerWidthLeft = "230px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "Segoe UI", "Arial", "sans-serif"]
            }
        }
    };

}
