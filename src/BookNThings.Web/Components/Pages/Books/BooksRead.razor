@page "/books-read"
@rendermode InteractiveServer
@inject IBookRepository Repository
@inject ILogger<BooksRead> Logger

<PageTitle>Books Read | BookNThings</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h3">Books Read</MudText>

    @if (isLoading)
    {
        <MudPaper Class="panel loading-panel" Elevation="0">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>Loading books read</MudText>
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudPaper Class="panel" Elevation="0">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@errorMessage</MudAlert>
        </MudPaper>
    }
    else if (books.Count == 0)
    {
        <MudPaper Class="empty-state" Elevation="0">
            <MudText Typo="Typo.h5">No books read yet</MudText>
            <MudText Class="muted-text">Search for books and save a few candidates to build your Books Read list.</MudText>
            <MudButton Href="search" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search">Search books</MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="panel search-panel" Elevation="0">
            <form @onsubmit="ApplySearch" @onsubmit:preventDefault="true">
                <MudTextField @bind-Value="searchText"
                              Placeholder="Search books read"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="false" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" StartIcon="@Icons.Material.Filled.Search">
                    Search
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" ButtonType="ButtonType.Button" OnClick="ClearSearch" StartIcon="@Icons.Material.Filled.Clear">
                    Clear
                </MudButton>
            </form>
        </MudPaper>

        <MudPaper Class="panel table-panel" Elevation="0">
            <MudTable Items="@BooksReadFiltered" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="25">
                <ColGroup>
                    <col class="date-read-column" />
                    <col />
                    <col />
                    <col />
                    <col />
                    <col />
                    <col />
                </ColGroup>
                <HeaderContent>
                    <MudTh Class="date-read-column">Date read</MudTh>
                    <MudTh>Title</MudTh>
                    <MudTh>Author</MudTh>
                    <MudTh>Published</MudTh>
                    <MudTh>Pages</MudTh>
                    <MudTh>Genres</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Date read" Class="date-read-column">@context.DateRead!.Value.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Title">
                        <MudTooltip Arrow="true" Placement="Placement.Top">
                            <ChildContent>
                                <MudText Typo="Typo.subtitle2">@context.Title</MudText>
                            </ChildContent>
                            <TooltipContent>
                                <div class="book-description-tooltip">@context.Description</div>
                            </TooltipContent>
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Author">@context.Author</MudTd>
                    <MudTd DataLabel="Published">@context.DatePublished.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Pages">@context.Pages</MudTd>
                    <MudTd DataLabel="Genres">@string.Join(", ", context.Genres)</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Href="@($"books-read/{context.Id}")" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit">
                            Edit
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="muted-text">No books match your search.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    }
</MudStack>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private string searchText = "";
    private string appliedSearchText = "";
    private List<Book> books = [];
    private IEnumerable<Book> BooksReadFiltered => books
        .Where(MatchesSearch)
        .OrderByDescending(item => item.DateRead)
        .ThenBy(item => item.Title);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            books = (await Repository.GetAllAsync(CancellationToken.None))
                .Where(book => book.DateRead.HasValue)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading books read failed.");
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplySearch()
    {
        appliedSearchText = searchText.Trim();
    }

    private void ClearSearch()
    {
        searchText = "";
        appliedSearchText = "";
    }

    private bool MatchesSearch(Book book)
    {
        if (string.IsNullOrWhiteSpace(appliedSearchText))
        {
            return true;
        }

        return ContainsSearchText(book.Title)
            || ContainsSearchText(book.Description)
            || ContainsSearchText(book.Author)
            || book.Genres.Any(ContainsSearchText);
    }

    private bool ContainsSearchText(string? value) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Contains(appliedSearchText, StringComparison.OrdinalIgnoreCase);
}
