@page "/settings"
@rendermode InteractiveServer
@inject BookNThings.Infrastructure.Health.ConnectionStatusService StatusService
@inject ILocalJsonStorageSettings StorageSettings
@inject ILogger<Settings> Logger
@inject IJSRuntime JS

<PageTitle>Settings | BookNThings</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h3">Settings</MudText>
    <div>
        <MudText Typo="Typo.h6">Configuration</MudText>
        <MudText Class="muted-text">Check OpenAI status before searching or saving.</MudText>
    </div>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="panel" Elevation="0">
                <MudText Typo="Typo.h6">OpenAI</MudText>
                <MudList T="string" Dense="true">
                    <MudListItem Icon="@StatusIcon(StatusService.IsOpenAiConfigured)" IconColor="@StatusColor(StatusService.IsOpenAiConfigured)">
                        API key: @ConfiguredText(StatusService.IsOpenAiConfigured)
                    </MudListItem>
                    <MudListItem Icon="@StatusIcon(StatusService.IsOpenAiModelConfigured)" IconColor="@StatusColor(StatusService.IsOpenAiModelConfigured)">
                        Model: @ConfiguredText(StatusService.IsOpenAiModelConfigured)
                    </MudListItem>
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="panel" Elevation="0">
                <MudText Typo="Typo.h6">IGDB</MudText>
                <MudList T="string" Dense="true">
                    <MudListItem Icon="@StatusIcon(StatusService.IsIgdbClientIdConfigured)" IconColor="@StatusColor(StatusService.IsIgdbClientIdConfigured)">
                        Client ID: @ConfiguredText(StatusService.IsIgdbClientIdConfigured)
                    </MudListItem>
                    <MudListItem Icon="@StatusIcon(StatusService.IsIgdbClientSecretConfigured)" IconColor="@StatusColor(StatusService.IsIgdbClientSecretConfigured)">
                        Client secret: @ConfiguredText(StatusService.IsIgdbClientSecretConfigured)
                    </MudListItem>
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="panel" Elevation="0">
                <MudText Typo="Typo.h6">Local JSON Storage</MudText>
                <MudText Class="muted-text">
                    This folder is stored for this app on the server machine. Enter a path the app process can read and write.
                </MudText>
                <MudText Class="muted-text">
                    Browse opens a browser prompt to help you paste or type a path. The app still validates the server folder path before saving.
                </MudText>

                <MudTextField @bind-Value="dataDirectory"
                              Label="Storage folder"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Immediate="true"
                              Error="@hasStorageDirectoryError"
                              ErrorText="@storageDirectoryError" />

                <MudText Typo="Typo.caption" Class="muted-text">
                    The app keeps `books.json`, `games.json`, and `show.json` in this folder.
                </MudText>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="BrowseStorageDirectoryAsync"
                               Disabled="@isSavingStorage"
                               StartIcon="@Icons.Material.Filled.FolderOpen">
                        Browse
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SaveStorageDirectoryAsync"
                               Disabled="@(isSavingStorage || hasStorageDirectoryError)"
                               StartIcon="@Icons.Material.Filled.Save">
                        Save location
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="ResetStorageDirectoryAsync"
                               Disabled="@isSavingStorage"
                               StartIcon="@Icons.Material.Filled.Restore">
                        Reset to default folder
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrWhiteSpace(storageMessage))
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@storageMessage</MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@errorMessage</MudAlert>
    }
</MudStack>

@code {
    private bool isSavingStorage;
    private string _dataDirectory = "";
    private string dataDirectory
    {
        get => _dataDirectory;
        set
        {
            _dataDirectory = value;
            storageDirectoryError = ValidateStorageDirectory(value);
        }
    }

    private bool hasStorageDirectoryError => !string.IsNullOrWhiteSpace(storageDirectoryError);
    private string? storageMessage;
    private string? errorMessage;
    private string? storageDirectoryError;

    private static string ConfiguredText(bool value) => value ? "Configured" : "Missing";

    private static Color StatusColor(bool value) => value ? Color.Success : Color.Error;

    private static string StatusIcon(bool value) => value ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error;

    protected override void OnInitialized()
    {
        dataDirectory = StorageSettings.DataDirectory;
    }

    private async Task BrowseStorageDirectoryAsync()
    {
        var selectedDirectory = await JS.InvokeAsync<string?>(
            "bookNThingsSettings.pickStorageDirectory",
            dataDirectory);

        if (!string.IsNullOrWhiteSpace(selectedDirectory))
        {
            dataDirectory = selectedDirectory;
        }
    }

    private async Task SaveStorageDirectoryAsync()
    {
        storageMessage = null;
        errorMessage = null;
        isSavingStorage = true;

        try
        {
            storageDirectoryError = ValidateStorageDirectory(dataDirectory);
            if (hasStorageDirectoryError)
            {
                errorMessage = storageDirectoryError;
                return;
            }

            await StorageSettings.SetDataDirectoryAsync(dataDirectory, CancellationToken.None);
            dataDirectory = StorageSettings.DataDirectory;
            storageMessage = $"Local JSON storage folder saved to {StorageSettings.DataDirectory}.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving local JSON storage settings failed.");
            errorMessage = "Could not save the storage folder. Make sure the path is valid and writable by the app.";
        }
        finally
        {
            isSavingStorage = false;
        }
    }

    private static string? ValidateStorageDirectory(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Storage folder is required.";
        }

        try
        {
            _ = Path.GetFullPath(Environment.ExpandEnvironmentVariables(value));
            return null;
        }
        catch
        {
            return "Enter a valid folder path.";
        }
    }

    private async Task ResetStorageDirectoryAsync()
    {
        storageMessage = null;
        errorMessage = null;
        isSavingStorage = true;

        try
        {
            await StorageSettings.ResetToDefaultDataDirectoryAsync(CancellationToken.None);
            dataDirectory = StorageSettings.DataDirectory;
            storageMessage = $"Local JSON storage folder reset to the default Data folder at {StorageSettings.DataDirectory}.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Resetting local JSON storage settings failed.");
            errorMessage = "Could not reset the storage folder. The app will keep using the current folder.";
        }
        finally
        {
            isSavingStorage = false;
        }
    }
}
