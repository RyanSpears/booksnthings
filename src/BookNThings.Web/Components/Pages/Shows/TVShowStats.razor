@page "/tv-show-stats"
@rendermode InteractiveServer
@inject IShowRepository Repository
@inject ILogger<TVShowStats> Logger

<PageTitle>TV Show Stats | BookNThings</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h3">TV Show Stats</MudText>

    @if (isLoading)
    {
        <MudPaper Class="panel loading-panel" Elevation="0">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>Loading TV show stats</MudText>
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudPaper Class="panel" Elevation="0">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@errorMessage</MudAlert>
        </MudPaper>
    }
    else if (showsWatched.Count == 0)
    {
        <MudPaper Class="panel" Elevation="0">
            <MudText Class="muted-text">TV shows you watch will be summarized here by year.</MudText>
        </MudPaper>
    }
    else
    {
        <YearlyMediaSummaries Items="@showsWatched"
                              DateSelector="@(show => show.DateWatched)"
                              RatingSelector="@(show => show.Rating)"
                              TagsSelector="@(show => show.Genres)"
                              CountLabel="TV shows watched"
                              RatingLabel="Average rating"
                              EmptyTagsMessage="No genres have been added to these TV shows yet."
                              TagListAriaLabel="TV shows by genre" />
    }
</MudStack>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private List<Show> showsWatched = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            showsWatched = (await Repository.GetAllAsync(CancellationToken.None))
                .Where(show => show.DateWatched.HasValue)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading TV show stats failed.");
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
