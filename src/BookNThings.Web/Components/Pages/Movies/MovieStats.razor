@page "/movie-stats"
@rendermode InteractiveServer
@inject IMovieRepository Repository
@inject ILogger<MovieStats> Logger

<PageTitle>Movie Stats | BookNThings</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h3">Movie Stats</MudText>

    @if (isLoading)
    {
        <MudPaper Class="panel loading-panel" Elevation="0">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>Loading movie stats</MudText>
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudPaper Class="panel" Elevation="0">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@errorMessage</MudAlert>
        </MudPaper>
    }
    else if (moviesWatched.Count == 0)
    {
        <MudPaper Class="panel" Elevation="0">
            <MudText Class="muted-text">Movies you watch will be summarized here by year.</MudText>
        </MudPaper>
    }
    else
    {
        <YearlyMediaSummaries Items="@moviesWatched"
                              DateSelector="@(movie => movie.DateWatched)"
                              RatingSelector="@(movie => movie.Rating)"
                              TagsSelector="@(movie => movie.Genres)"
                              CountLabel="Movies watched"
                              RatingLabel="Average rating"
                              EmptyTagsMessage="No genres have been added to these movies yet."
                              TagListAriaLabel="Movies by genre" />
    }
</MudStack>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private List<Movie> moviesWatched = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            moviesWatched = (await Repository.GetAllAsync(CancellationToken.None))
                .Where(movie => movie.DateWatched.HasValue)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading movie stats failed.");
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
