@page "/currently-reading"
@rendermode InteractiveServer
@inject IBookRepository Repository
@inject ILogger<CurrentlyReading> Logger

<PageTitle>Currently Reading | BookNThings</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h3">Currently Reading</MudText>

    @if (isLoading)
    {
        <MudPaper Class="panel loading-panel" Elevation="0">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>Loading currently reading books</MudText>
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudPaper Class="panel" Elevation="0">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@errorMessage</MudAlert>
        </MudPaper>
    }
    else if (books.Count == 0)
    {
        <MudPaper Class="empty-state" Elevation="0">
            <MudText Typo="Typo.h5">No books are currently being read</MudText>
            <MudText Class="muted-text">Save a book from search without a read date to keep it here until you finish it.</MudText>
            <MudButton Href="search" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search">Search books</MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="panel search-panel" Elevation="0">
            <MudTextField @bind-Value="searchText"
                          Placeholder="Search currently reading"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="false" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplySearch" StartIcon="@Icons.Material.Filled.Search">
                Search
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ClearSearch" StartIcon="@Icons.Material.Filled.Clear">
                Clear
            </MudButton>
        </MudPaper>

        <MudPaper Class="panel table-panel" Elevation="0">
            <MudTable Items="@CurrentlyReadingFiltered" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="25">
                <ColGroup>
                    <col />
                    <col />
                    <col />
                    <col />
                    <col />
                    <col />
                </ColGroup>
                <HeaderContent>
                    <MudTh>Title</MudTh>
                    <MudTh>Author</MudTh>
                    <MudTh>Published</MudTh>
                    <MudTh>Pages</MudTh>
                    <MudTh>Genres</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Title">
                        <MudText Typo="Typo.subtitle2">@context.Title</MudText>
                        <MudText Typo="Typo.caption" Class="muted-text">@context.Description</MudText>
                    </MudTd>
                    <MudTd DataLabel="Author">@context.Author</MudTd>
                    <MudTd DataLabel="Published">@context.DatePublished.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Pages">@context.Pages</MudTd>
                    <MudTd DataLabel="Genres">@string.Join(", ", context.Genres)</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Href="@($"books-read/{context.Id}")" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.EventAvailable">
                            Mark as read
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="muted-text">No books match your search.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    }
</MudStack>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private string searchText = "";
    private string appliedSearchText = "";
    private List<Book> books = [];
    private IEnumerable<Book> CurrentlyReadingFiltered => books
        .Where(MatchesSearch)
        .OrderBy(item => item.Title);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            books = (await Repository.GetAllAsync(CancellationToken.None))
                .Where(book => !book.DateRead.HasValue)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading currently reading books failed.");
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplySearch()
    {
        appliedSearchText = searchText.Trim();
    }

    private void ClearSearch()
    {
        searchText = "";
        appliedSearchText = "";
    }

    private bool MatchesSearch(Book book)
    {
        if (string.IsNullOrWhiteSpace(appliedSearchText))
        {
            return true;
        }

        return ContainsSearchText(book.Title)
            || ContainsSearchText(book.Description)
            || ContainsSearchText(book.Author)
            || book.Genres.Any(ContainsSearchText);
    }

    private bool ContainsSearchText(string? value) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Contains(appliedSearchText, StringComparison.OrdinalIgnoreCase);
}
